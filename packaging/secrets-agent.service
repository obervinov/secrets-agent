[Unit]
Description=Apply secrets fetched from the secrets proxy
After=network-online.target docker.service
Wants=network-online.target docker.service
ConditionPathExists=/etc/secrets-agent.conf

[Service]
Type=oneshot
ExecStart=/usr/local/bin/secrets-agent
TimeoutStartSec=300
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
RestrictSUIDSGID=yes
ReadWritePaths=/opt/secrets /etc/systemd/system

[Install]
WantedBy=multi-user.target
