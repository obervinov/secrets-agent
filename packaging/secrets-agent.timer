[Unit]
Description=Poll the secrets proxy for changed secrets

[Timer]
# OnBootSec restores secrets after a reboot. The interval is calendar-based rather
# than OnUnitActiveSec: the monotonic anchor left NEXT empty on a host where the
# service had already run, and Persistent= only has an effect with OnCalendar.
OnBootSec=1min
OnCalendar=*:0/15
RandomizedDelaySec=60s
Persistent=true
Unit=secrets-agent.service

[Install]
WantedBy=timers.target
