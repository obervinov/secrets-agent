[Unit]
Description=Apply secrets fetched from the secrets proxy
After=network-online.target docker.service
Wants=network-online.target docker.service
# A host that was never provisioned for this stays quiet rather than failing every
# interval with an unreadable-config error.
ConditionPathExists=${config_path}

[Service]
Type=oneshot
ExecStart=${binary_path}
Environment=SECRETS_AGENT_CONF=${config_path}
TimeoutStartSec=300

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=${state_dir} /etc/systemd/system

[Install]
WantedBy=multi-user.target
